<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Community Service Projects</h2>

    <p>Explore our service projects:</p>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <h3><%= project.name %></h3>
                <p><%= project.description %></p>
                <p>Organization: <%= project.organization_name %></p>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>