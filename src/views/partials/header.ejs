<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <nav>
    <ul>
        <li>
            <a href="/"
                <% if (currentPath === '/') { %>
                    aria-current="page"
                <% } %>>
                Home
            </a>
        </li>

        <li>
            <a href="/organizations"
                <% if (currentPath === '/organizations' || currentPath.startsWith('/organization/')) { %>
                    aria-current="page"
                <% } %>>
                Organizations
            </a>
        </li>

        <li>
            <a href="/projects"
                <% if (currentPath === '/projects' || currentPath.startsWith('/project/')) { %>
                    aria-current="page"
                <% } %>>
                Projects
            </a>
        </li>

        <li>
            <a href="/categories"
                <% if (currentPath === '/categories' || currentPath.startsWith('/category/')) { %>
                    aria-current="page"
                <% } %>>
                Categories
            </a>
        </li>
    </ul>
</nav>

<% const messages = flash(); %>
    <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type].length > 0) { %>
            <div class="alert <%= type %>">
                <% messages[type].forEach(msg => { %>
                    <p><%= msg %></p>
                <% }); %>
            </div>
        <% } %>
    <% }); %>
